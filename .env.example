PORT=3300
# Chỉ nghe trên loopback; production đặt Cloudflare Tunnel/reverse proxy trước cổng này.
HOST=127.0.0.1
AUTH_REQUIRED=1
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
PUBLIC_URL=http://localhost:3300
# Múi giờ dùng để HIỂN THỊ (nhật ký engine, thời gian trên giao diện). CSDL luôn lưu UTC.
APP_TZ=Asia/Ho_Chi_Minh
# Tên cookie phiên / cổng truy cập (đổi khỏi tên mặc định cũ để giảm dấu vết sản phẩm).
AUTH_COOKIE=sid
GATE_COOKIE=gw
# 0 = đóng đăng ký công khai (admin tạo tài khoản); 1 = mở đăng ký.
REGISTER_OPEN=0
# Bật sau khi chạy: npm run build:public
# PUBLIC_DIR=dist/public
# Bật khi chạy sau HTTPS; Cloudflare Tunnel tự nhận x-forwarded-proto nên thường không cần.
# COOKIE_SECURE=1
